{
  "name": "jokopi",
  "version": "1.0.0",
  "description": "Backend for jokopi website",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun test",
    "introspect": "drizzle-kit introspect",
    "generate": "drizzle-kit generate",
    "migrate": "bun run src/infra/db/migrate.ts",
    "seed": "bun run src/infra/db/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/jwt": "^1.3.2",
    "@elysiajs/swagger": "^1.3.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "elysia": "^1.3.8",
    "pg": "^8.16.3",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3"
  }
}
